{
    "name": "@frontify/frontify-plugin",
    "description": "Connecting your brand and design worlds",
    "version": "2.3.22",
    "repository": {
        "type": "git",
        "url": "https://github.com/Frontify/sketch.git"
    },
    "engines": {
        "node": ">=22",
        "sketch": ">=100.0"
    },
    "scripts": {
        "build": "webpack --mode production",
        "watch": "webpack --mode development --watch",
        "start": "webpack --mode development --watch",
        "link": "node scripts/link.js",
        "postinstall": "npm run build && npm run link"
    },
    "devDependencies": {
        "@babel/plugin-proposal-optional-chaining": "^7.21.0",
        "@babel/plugin-syntax-async-generators": "^7.8.4",
        "@babel/plugin-transform-runtime": "^7.19.6",
        "babel-loader": "^8.3.0",
        "copy-webpack-plugin": "5.1.2",
        "css-loader": "^5.0.0",
        "dot-tpl-loader": "1.2.1",
        "file-loader": "1.1.11",
        "html-loader": "^1.0.0",
        "regexp-replace-loader": "1.0.1",
        "style-loader": "0.23.1",
        "webpack": "^4.47.0",
        "webpack-cli": "^3.3.12",
        "webpack-concat-plugin": "^3.0.0"
    },
    "dependencies": {
        "@babel/runtime": "^7.20.7",
        "mocha-js-delegate": "0.2.0",
        "sketch-module-web-view": "3.5.1"
    },
    "overrides": {
        "loader-utils": "1.4.2",
        "json5": "2.2.3"
    }
}
